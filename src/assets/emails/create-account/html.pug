doctype html
html
  head
    block head
      meta(charset="utf-8")
      meta(name="viewport", content="width=device-width")
      meta(http-equiv="X-UA-Compatible", content="IE=edge")
      meta(name="x-apple-disable-message-reformatting")
      link(rel="stylesheet", href="style.css", data-inline)
  body
    div.frame.large
      div.center: img.head(src=logoUrl alt="UNESCO")

      p #{t('createAccount.intro', { senderName: senderName })}
      p #{t('createAccount.platformInfo')}
      p #{t('createAccount.stepsIntro')}
      ol
        li: span #{t('createAccount.steps.1')}
        li: span #{t('createAccount.steps.2')}
        li: span #{t('createAccount.steps.3')}

      p.center: a.button(href=registerUrl target="_blank") #{t('createAccount.registerButton')}

      p
        strong #{t('createAccount.noteTitle')}
        | #{t('createAccount.noteContent')}
      p #{t('createAccount.thanks')}
      p #{t('createAccount.signature')}
      p
        | #{t('createAccount.registerDirectly')}
        a(href=registerUrl) #{registerUrl}

      p.footer.center #{t('createAccount.footer')}
